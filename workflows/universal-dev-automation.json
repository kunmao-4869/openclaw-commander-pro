{
  "name": "通用开发自动化工作流模板",
  "version": "1.0.0",
  "description": "支持任意 IDE 的自动化开发工作流",
  "workflows": [
    {
      "id": "create-project-basic",
      "name": "创建基础项目",
      "description": "自动创建新项目并设置基础文件结构",
      "steps": [
        {
          "action": "auto_connect",
          "description": "自动检测并连接已打开的 IDE"
        },
        {
          "action": "create_file",
          "params": {
            "filePath": "src/index.ts",
            "content": "// 主入口文件\nconsole.log('Hello World');"
          },
          "delay": 1000
        },
        {
          "action": "create_file",
          "params": {
            "filePath": "src/utils.ts",
            "content": "// 工具函数\nexport function helper() {\n  return 'helper';\n}"
          },
          "delay": 1000
        },
        {
          "action": "save_all"
        }
      ]
    },
    {
      "id": "edit-refactor",
      "name": "代码重构",
      "description": "自动查找并重构代码",
      "steps": [
        {
          "action": "auto_connect"
        },
        {
          "action": "open_file",
          "params": {
            "filePath": "src/main.ts"
          }
        },
        {
          "action": "edit_file",
          "params": {
            "searchText": "var ",
            "replaceText": "let "
          },
          "delay": 500
        },
        {
          "action": "format_code"
        },
        {
          "action": "save"
        }
      ]
    },
    {
      "id": "build-and-run",
      "name": "构建并运行",
      "description": "自动构建项目并运行",
      "steps": [
        {
          "action": "auto_connect"
        },
        {
          "action": "save_all"
        },
        {
          "action": "build",
          "delay": 5000
        },
        {
          "action": "run",
          "delay": 3000
        }
      ]
    },
    {
      "id": "debug-session",
      "name": "调试会话",
      "description": "启动调试会话",
      "steps": [
        {
          "action": "auto_connect"
        },
        {
          "action": "go_to_line",
          "params": {
            "lineNumber": 50
          }
        },
        {
          "action": "debug",
          "delay": 2000
        }
      ]
    },
    {
      "id": "code-review",
      "name": "代码审查",
      "description": "执行代码审查和自动修复",
      "steps": [
        {
          "action": "auto_connect"
        },
        {
          "action": "code_review",
          "delay": 3000
        },
        {
          "action": "save_all"
        }
      ]
    }
  ]
}
